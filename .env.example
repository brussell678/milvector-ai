NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only. Required for retirement invitation RSVPs and guest messages
# (they return "not set up" without it once migration 0036 has run), business
# card leads, and feedback attachments in the admin email.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Models and reasoning effort default in lib/env.ts (gpt-6-luna for light
# tools, gpt-6.2-sol for the resume builders). Set any of these only to override.
# OPENAI_MODEL=gpt-6-luna
# TOOLS_MODEL=gpt-6-luna
# MASTER_RESUME_MODEL=gpt-6.2-sol
# MASTER_STRUCTURE_MODEL=gpt-6-luna
# TARGETED_RESUME_MODEL=gpt-6.2-sol
# LLM_REASONING_EFFORT=low
# TARGETED_RESUME_EFFORT=medium
# Fit check shared by the JD Decoder and the Targeted Resume Builder; falls back
# to TARGETED_RESUME_MODEL and TARGETED_RESUME_EFFORT.
# FIT_CHECK_MODEL=
# FIT_CHECK_EFFORT=
LLM_TIMEOUT_MS=30000
# AI runs allowed per user per rolling 24 hours (default 60)
# AI_DAILY_RUN_LIMIT=60
# Chat tools (docs/CHAT_TOOLS_PLAN.md). Follow-up questions per user per
# rolling 24 hours, apart from the run limit (default 100); the model and
# effort for answers (default TOOLS_MODEL and LLM_REASONING_EFFORT).
# CHAT_DAILY_MESSAGE_LIMIT=100
# CHAT_MODEL=
# CHAT_EFFORT=
# Each chat view shows to the admin only until its tool is listed here, by
# short name, comma-separated: mos (the MOS Translator).
# CHAT_TOOLS_PUBLIC=mos
# OPENAI_BASE_URL=https://api.openai.com/v1
# MAX_UPLOAD_MB=10

# Email notifications (Resend)
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_EMAIL=support@yourdomain.com
ADMIN_NOTIFY_EMAIL=you@yourdomain.com
# Base URL for links in emails; defaults to https://www.milvector.org.
NEXT_PUBLIC_APP_URL=https://www.milvector.org

# The Digital Business Card and Retirement Invitation Builder are open to every
# member. Set either to false to close it (takes effect on the next deploy).
# CARD_BUILDER_PUBLIC=false
# RETIREMENT_INVITE_PUBLIC=false
# Wallet passes are off until these are set. See docs/WALLET_SETUP.md.
# APPLE_PASS_TYPE_ID=
# APPLE_TEAM_ID=
# APPLE_PASS_CERT=
# APPLE_PASS_KEY=
# APPLE_PASS_KEY_PASSPHRASE=
# APPLE_WWDR_CERT=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=
