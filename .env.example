NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional: enables embedding feedback attachments directly in the admin email.
# Without it, tickets still email and the image is viewable inline in the admin portal.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Models and reasoning effort default in lib/env.ts (gpt-6-luna for light
# tools, gpt-6.2-sol for the resume builders). Set any of these only to override.
# OPENAI_MODEL=gpt-6-luna
# TOOLS_MODEL=gpt-6-luna
# MASTER_RESUME_MODEL=gpt-6.2-sol
# MASTER_STRUCTURE_MODEL=gpt-6-luna
# TARGETED_RESUME_MODEL=gpt-6.2-sol
# LLM_REASONING_EFFORT=low
# TARGETED_RESUME_EFFORT=medium
# Fit check shared by the JD Decoder and the Targeted Resume Builder; falls back
# to TARGETED_RESUME_MODEL and TARGETED_RESUME_EFFORT.
# FIT_CHECK_MODEL=
# FIT_CHECK_EFFORT=
LLM_TIMEOUT_MS=30000
# AI runs allowed per user per rolling 24 hours (default 60)
# AI_DAILY_RUN_LIMIT=60
# OPENAI_BASE_URL=https://api.openai.com/v1
# MAX_UPLOAD_MB=10

# Email notifications (Resend)
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_EMAIL=support@yourdomain.com
ADMIN_NOTIFY_EMAIL=brussell678@gmail.com
NEXT_PUBLIC_APP_URL=https://milvectorai.com

# Digital Business Card builder: admin-only preview until this is set.
# CARD_BUILDER_PUBLIC=true
# Retirement Invitation Builder: admin-only preview until this is set.
# RETIREMENT_INVITE_PUBLIC=true
# Wallet passes are off until these are set. See docs/WALLET_SETUP.md.
# APPLE_PASS_TYPE_ID=
# APPLE_TEAM_ID=
# APPLE_PASS_CERT=
# APPLE_PASS_KEY=
# APPLE_PASS_KEY_PASSPHRASE=
# APPLE_WWDR_CERT=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=
